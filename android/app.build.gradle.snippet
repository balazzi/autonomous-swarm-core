// android/app/build.gradle — merge this into your app module.
// Links the cargo-ndk ARM64 .so produced by the CI matrix.

android {
    compileSdk 34

    defaultConfig {
        applicationId "com.security.swarm"
        minSdk 24
        targetSdk 34
        ndk {
            abiFilters "arm64-v8a" // 64-bit isolation; x86_64 for emulator QA builds
        }
    }

    sourceSets {
        main {
            // CI copies target/aarch64-linux-android/release/libautonomous_swarm_core.so here
            jniLibs.srcDirs = ['src/main/jniLibs']
        }
    }

    buildTypes {
        release {
            minifyEnabled false // native .so is already LTO'd + stripped by cargo
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
    }
}

dependencies {
    // VpnService path needs no extra deps; billing uses Play Billing Library:
    implementation 'com.android.billingclient:billing:7.1.1'
}
