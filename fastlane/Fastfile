# Lead Architect Master Enterprise Automation Orchestrator
default_platform(:android)

platform :android do
  desc "Compile native core, bundle AAB, deliver to Google Play internal track"
  lane :submit_android_app do
    sh(command: "cargo build --release --target aarch64-linux-android")
    sh(command: "mkdir -p android/app/src/main/jniLibs/arm64-v8a && " \
      "cp target/aarch64-linux-android/release/libautonomous_swarm_core.so " \
      "android/app/src/main/jniLibs/arm64-v8a/")
    gradle(task: "clean bundleRelease", project_directory: "android/")
    upload_to_play_store(
      track: "internal",
      package_name: "com.security.swarm",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      metadata_path: "./fastlane/metadata/android"
    )
  end
end

platform :ios do
  desc "Compile static core, archive, upload to TestFlight"
  lane :submit_ios_app do
    sh(command: "cargo build --release --target aarch64-apple-ios")
    api_key = app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_ISSUER_ID"],
      key_content: ENV["APPLE_API_KEY_CONTENT"]
    )
    gym(
      scheme: "SwarmCore",
      workspace: "ios/SwarmCore.xcworkspace",
      export_options: "ios/exportOptions.plist"
    )
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.security.swarm.ios",
      skip_waiting_for_build_processing: true
    )
  end
end
